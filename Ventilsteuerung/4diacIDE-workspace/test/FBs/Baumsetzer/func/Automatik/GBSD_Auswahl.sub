<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="GBSD_Auswahl" Comment="Waehlt per Button die bodenbasierte Geschwindigkeit/Distanz (GBSD) als Quelle aus, merkt sich die Auswahl persistent im NVS, setzt bei Auswahl die anderen Quellen zurueck und liefert die GBSD-Sensordaten nach aussen">
	<Identification Standard="61499-2">
	</Identification>
	<VersionInfo Version="1.0" Author="Franz" Date="2026-08-27">
	</VersionInfo>
	<CompilerInfo packageName="FBs::Baumsetzer::func::Automatik">
		<Import declaration="NVS_Keys::Key_GBSD_Store"/>
		<Import declaration="isobus::UT::io::Button::ButtonActivationCode::BT_RELEASED_UNLATCHED"/>
		<Import declaration="test::FBs::Baumsetzer::Constants::DefaultPool::Button_GBSD"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventInputs>
			<SubAppEvent Name="Reset" Type="Event" Comment="Anforderung von einer der anderen Quellen: eigene Auswahl zuruecksetzen">
			</SubAppEvent>
		</SubAppEventInputs>
		<SubAppEventOutputs>
			<SubAppEvent Name="Chosen" Type="Event" Comment="Button_GBSD wurde gedrueckt: eigene Auswahl setzen und alle anderen Quellen zuruecksetzen">
			</SubAppEvent>
			<SubAppEvent Name="Updated" Type="Event" Comment="Ausgewaehlt-Status verfuegbar bzw. geaendert (Init-Lesen oder Aenderung); Trigger fuer nachgelagerte Verarbeitung (u.a. Hintergrundfarbe)">
			</SubAppEvent>
			<SubAppEvent Name="IND" Type="Event" Comment="Neue GBSD-Daten empfangen (Indication von I_GBSD)">
			</SubAppEvent>
		</SubAppEventOutputs>
		<OutputVars>
			<VarDeclaration Name="Selected" Type="BOOL" Comment="TRUE wenn GBSD aktuell als Geschwindigkeitsquelle ausgewaehlt ist"/>
			<VarDeclaration Name="GROUNDBASEDMACHINESPEED" Type="UINT" Comment="Bodenbasierte Maschinengeschwindigkeit (PGN 65097, SPN 1859)"/>
			<VarDeclaration Name="GROUNDBASEDMACHINEDISTANCE" Type="UDINT" Comment="Bodenbasierte Maschinendistanz (PGN 65097, SPN 1860)"/>
			<VarDeclaration Name="GROUNDBASEDMACHINEDIRECTION" Type="BYTE" Comment="Bodenbasierte Fahrtrichtung (PGN 65097, SPN 1861)"/>
		</OutputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="Button_GBSD" Type="isobus::UT::io::Button::Button_IE" x="100" y="3200">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="u16ObjId" Value="Button_GBSD"/>
			<Parameter Name="InputEvent" Value="BT_RELEASED_UNLATCHED"/>
		</FB>
		<FB Name="E_T_FF_SR" Type="iec61499::events::E_T_FF_SR" x="2600" y="3200">
		</FB>
		<FB Name="GBSD_Selected" Type="logiBUS::storage::esp32_nvs::NVS" x="5000" y="3100">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="KEY" Value="Key_GBSD_Store"/>
			<Parameter Name="DEFAULT_VALUE" Value="bool#FALSE"/>
		</FB>
		<FB Name="F_MOVE" Type="iec61131::selection::F_MOVE" x="7300" y="3200">
			<Attribute Name="DataType" Value="BOOL"/>
		</FB>
		<FB Name="I_GBSD" Type="isobus::tecu::I_GBSD" x="9700" y="3200">
			<Parameter Name="QI" Value="FALSE"/>
		</FB>
		<EventConnections>
			<Connection Source="Button_GBSD.IND" Destination="E_T_FF_SR.S" dx1="646.67"/>
			<Connection Source="Button_GBSD.IND" Destination="Chosen" dx1="646.67"/>
			<Connection Source="Reset" Destination="E_T_FF_SR.R" dx1="6306.67"/>
			<Connection Source="E_T_FF_SR.EO" Destination="GBSD_Selected.SET" dx1="740"/>
			<Connection Source="GBSD_Selected.SETO" Destination="F_MOVE.REQ" dx1="260"/>
			<Connection Source="GBSD_Selected.GETO" Destination="F_MOVE.REQ" dx1="253.33"/>
			<Connection Source="F_MOVE.CNF" Destination="Updated" dx1="553.33"/>
			<Connection Source="I_GBSD.IND" Destination="IND" dx1="400"/>
			<Connection Source="F_MOVE.CNF" Destination="I_GBSD.INIT"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="E_T_FF_SR.Q" Destination="GBSD_Selected.VALUE" dx1="740"/>
			<Connection Source="GBSD_Selected.VALUEO" Destination="F_MOVE.IN" dx1="253.33"/>
			<Connection Source="F_MOVE.OUT" Destination="I_GBSD.QI" dx1="906.67"/>
			<Connection Source="F_MOVE.OUT" Destination="Selected" dx1="906.67"/>
			<Connection Source="I_GBSD.GROUNDBASEDMACHINESPEED" Destination="GROUNDBASEDMACHINESPEED" dx1="1960"/>
			<Connection Source="I_GBSD.GROUNDBASEDMACHINEDISTANCE" Destination="GROUNDBASEDMACHINEDISTANCE" dx1="2106.67"/>
			<Connection Source="I_GBSD.GROUNDBASEDMACHINEDIRECTION" Destination="GROUNDBASEDMACHINEDIRECTION" dx1="2346.67"/>
		</DataConnections>
	</SubAppNetwork>
</SubAppType>
