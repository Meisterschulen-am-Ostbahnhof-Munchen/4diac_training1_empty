<?xml version="1.0" encoding="UTF-8"?>
<SubAppType Name="NMEA_Auswahl" Comment="Waehlt per Button die NMEA2000-Geschwindigkeit ueber Grund (Speed over Ground) als Quelle aus, merkt sich die Auswahl persistent im NVS, setzt bei Auswahl die anderen Quellen zurueck und liefert die NMEA-Sensordaten nach aussen">
	<Identification Standard="61499-2">
	</Identification>
	<VersionInfo Version="1.0" Author="Franz" Date="2026-08-27">
	</VersionInfo>
	<CompilerInfo packageName="FBs::Baumsetzer::func::Automatik">
		<Import declaration="NVS_Keys::Key_NMEA_Store"/>
		<Import declaration="isobus::UT::io::Button::ButtonActivationCode::BT_RELEASED_UNLATCHED"/>
		<Import declaration="test::FBs::Baumsetzer::Constants::DefaultPool::Button_NMEA"/>
	</CompilerInfo>
	<SubAppInterfaceList>
		<SubAppEventInputs>
			<SubAppEvent Name="Reset" Type="Event" Comment="Anforderung von einer der anderen Quellen: eigene Auswahl zuruecksetzen">
			</SubAppEvent>
		</SubAppEventInputs>
		<SubAppEventOutputs>
			<SubAppEvent Name="Chosen" Type="Event" Comment="Button_NMEA wurde gedrueckt: eigene Auswahl setzen und alle anderen Quellen zuruecksetzen">
			</SubAppEvent>
			<SubAppEvent Name="Updated" Type="Event" Comment="Ausgewaehlt-Status verfuegbar bzw. geaendert (Init-Lesen oder Aenderung); Trigger fuer nachgelagerte Verarbeitung (u.a. Hintergrundfarbe)">
			</SubAppEvent>
			<SubAppEvent Name="IND" Type="Event" Comment="Neue NMEA-Daten empfangen (Indication von COGSOGRapidUpdate)">
			</SubAppEvent>
		</SubAppEventOutputs>
		<OutputVars>
			<VarDeclaration Name="Selected" Type="BOOL" Comment="TRUE wenn NMEA aktuell als Geschwindigkeitsquelle ausgewaehlt ist"/>
			<VarDeclaration Name="SpeedOverGround" Type="UINT" Comment="Geschwindigkeit ueber Grund aus NMEA2000 COG&amp;SOG Rapid Update (PGN 129026)"/>
			<VarDeclaration Name="timestamp_data" Type="DINT" Comment="Zeitstempel der letzten NMEA-Botschaft"/>
		</OutputVars>
	</SubAppInterfaceList>
	<SubAppNetwork>
		<FB Name="Button_NMEA" Type="isobus::UT::io::Button::Button_IE" x="100" y="1400">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="u16ObjId" Value="Button_NMEA"/>
			<Parameter Name="InputEvent" Value="BT_RELEASED_UNLATCHED"/>
		</FB>
		<FB Name="E_T_FF_SR" Type="iec61499::events::E_T_FF_SR" x="2800" y="1600">
		</FB>
		<FB Name="NMEA_Selected" Type="logiBUS::storage::esp32_nvs::NVS" x="5100" y="1500">
			<Parameter Name="QI" Value="TRUE"/>
			<Parameter Name="KEY" Value="Key_NMEA_Store"/>
			<Parameter Name="DEFAULT_VALUE" Value="bool#FALSE"/>
		</FB>
		<FB Name="F_MOVE" Type="iec61131::selection::F_MOVE" x="7400" y="1600">
			<Attribute Name="DataType" Value="BOOL"/>
		</FB>
		<FB Name="COGSOGRapidUpdate" Type="isobus::tecu::I_COGSOGRapidUpdate" x="9800" y="1600">
		</FB>
		<EventConnections>
			<Connection Source="Button_NMEA.IND" Destination="E_T_FF_SR.S" dx1="746.67"/>
			<Connection Source="Button_NMEA.IND" Destination="Chosen" dx1="746.67"/>
			<Connection Source="Reset" Destination="E_T_FF_SR.R" dx1="6453.33"/>
			<Connection Source="E_T_FF_SR.EO" Destination="NMEA_Selected.SET" dx1="786.67"/>
			<Connection Source="NMEA_Selected.SETO" Destination="F_MOVE.REQ" dx1="626.67"/>
			<Connection Source="NMEA_Selected.GETO" Destination="F_MOVE.REQ" dx1="253.33"/>
			<Connection Source="F_MOVE.CNF" Destination="Updated" dx1="553.33"/>
			<Connection Source="COGSOGRapidUpdate.IND" Destination="IND" dx1="180"/>
			<Connection Source="F_MOVE.CNF" Destination="COGSOGRapidUpdate.INIT"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="E_T_FF_SR.Q" Destination="NMEA_Selected.VALUE" dx1="593.33"/>
			<Connection Source="NMEA_Selected.VALUEO" Destination="F_MOVE.IN" dx1="253.33"/>
			<Connection Source="F_MOVE.OUT" Destination="COGSOGRapidUpdate.QI" dx1="906.67"/>
			<Connection Source="F_MOVE.OUT" Destination="Selected" dx1="906.67"/>
			<Connection Source="COGSOGRapidUpdate.SpeedOverGround" Destination="SpeedOverGround" dx1="4146.67"/>
			<Connection Source="COGSOGRapidUpdate.timestamp_data" Destination="timestamp_data" dx1="626.67"/>
		</DataConnections>
	</SubAppNetwork>
</SubAppType>
